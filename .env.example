# ─── AI Classification ────────────────────────────────────────────────
# Reply classification is Jev (same Decisions API call-tagger uses).
# Fail-fast if these are missing at classify time; never hardcode them.
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_API_KEY=your-openrouter-api-key
# JEV_MODEL=typesafe/jev-1.13
# CLASSIFIER_FALLBACK_GEMINI=1
# SUPPRESS_PITCHES=1
# JEV_TIMEOUT_MS=15000

GEMINI_API_KEY=your-gemini-api-key

# Manual-reply retrieval + Claude drafting (realtime webhooks only).
# Pollers / backfill scripts always use Gemini — Claude is hard-disabled for bulk.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Current model defaults (optional overrides):
# ANTHROPIC_REPLY_MODEL=claude-sonnet-5
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Slack ────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Required for every /admin route (header ADMIN_API_KEY). Fail-closed if unset.
ADMIN_API_KEY=long-random-string-for-admin-routes

# Optional: /auth/gmail/connect ?secret= (falls back to this if AUTH_CONNECT_SECRET unset)
WEBHOOK_TEST_SECRET=long-random-string-for-local-slack-testing

# Campaignintelligence booking page → stop follow-ups
# POST /webhook/booking-bridge with Authorization: Bearer <this>
# Must match campaignintelligence REPLYHANDLER_WEBHOOK_SECRET
# BOOKING_BRIDGE_WEBHOOK_SECRET=
# Booked-meeting email: POST /webhook/booking-bridge/booked-email (same bearer secret) emails the call
# summary + prospect contact info from the connected primary Gmail. Recipient is fixed server-side.
# BOOKED_MEETING_EMAIL_TO=joshua@salesglidergrowth.com   (To only when the client has no always-CC)
# To = client always-CC; CC = BOOKED_MEETING_EMAIL_CC (default cayden@salesglidergrowth.com) + Josh. Nobody else (Gabe removed Oct 29).
# BOOKED_MEETING_EMAIL_CC=cayden@salesglidergrowth.com
# LinkedIn URL in the email: payload first, then the reply cards' capped lookup; set to off to disable
# BOOKED_MEETING_LINKEDIN_LOOKUP=off
# Follow-up runner also pulls booking_events via SUPABASE_URL (same project)
# to catch missed/raced webhook confirms before posting a FOLLOW_UP card.

# Optional: IANA timezone for displaying verified slot labels (default America/New_York)
# DEFAULT_BOOKING_TIMEZONE=America/Los_Angeles

# Cadence override (hours from our send). Default is clock-based first step
# (3:30pm America/Chicago the day the inbound arrived, next day if after 2pm CT)
# then 24h → 48h → 1 week. Setting this replaces the whole sequence.
# FOLLOW_UP_HOURS=2,24,48,168
# Retire a step if still pending this many hours past due (no backlog replay)
# FOLLOW_UP_MAX_AGE_HOURS=24
# Dedicated Slack channel for FOLLOW_UP bumps (default C0BRRS8DV19)
# FOLLOW_UP_SLACK_CHANNEL_ID=C0BRRS8DV19

# SmartLead cross-client signature / mailbox QA lives in Deliverability Wizard.
# ReplyHandler must NOT scan sends, Slack, or auto-pause/unpause campaigns for
# foreign signatures. Do not reintroduce SMARTLEAD_SENDER_GUARD_* here.

# ─── Lead Enrichment ─────────────────────────────────────────────────
# Email Waterfall /enrich-one: GetLeads → Smartlead → AI Ark → Prospeo → FullEnrich
# EMAIL_WATERFALL_URL=https://email-waterfall.example.up.railway.app
# EMAIL_WATERFALL_CLIENT_TAG=replyhandler
# EMAIL_WATERFALL_MAX_TIER=fullenrich
# Default ceiling $0.25. INTERESTED / MEETING_PROPOSED use $1.00 (FullEnrich mobile).
# REPLY_ENRICH_CEILING_USD=0.25
# REPLY_ENRICH_CEILING_HOT_USD=1.00
# Paid LinkedIn lookup on a Slack card when cheap sources miss. Estimate first.
# REPLY_LINK_LOOKUP_CEILING_USD=0.05
# Slack-card ICP verdict reuses topup icp-llm / icp_variants. Cache by
# client+domain. Estimate ~$0.002 (Gemini) or $0 from the shared cache.
# REPLY_ICP_CEILING_USD=0.02
# REPLY_ICP_ESTIMATE_USD=0.002
# New clients without a stored / topup variant get an ICP from Josh's
# Fireflies call transcripts. Missing this key flags the client needs_review.
# FIREFLIES_API_KEY=
GETLEADS_API_KEY=your-getleads-api-key
AIARK_API_KEY=your-ai-ark-api-key

# ─── Primary Gmail (client notify from joshua@salesglidergrowth.com) ─
GMAIL_CLIENT_ID=your-gmail-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
PRIMARY_GMAIL_FROM=joshua@salesglidergrowth.com
# Extra CC on every client FYI ("we just replied"). Comma-separated.
# Unset uses the default ops teammate address. Set empty to disable.
# FYI_CC_EMAILS=
# Reply-To on those FYIs (ops inbox). Defaults to PRIMARY_GMAIL_FROM.
# FYI_REPLY_TO=
# Optional: require ?secret=... on /auth/gmail/connect (falls back to WEBHOOK_TEST_SECRET)
# PRIMARY_GMAIL_CONNECT_SECRET=

# ─── Google Calendar OAuth (console.cloud.google.com) ────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Microsoft / Outlook OAuth (portal.azure.com) ────────────────────
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret

# ─── Client portal ───────────────────────────────────────────────────
# Supabase project URL (not salesglider.ai). Shared secret goes both ways
# as header x-portal-secret: we POST /functions/v1/provision-client, they POST /client-action.
# PORTAL_URL=https://scvrsmfzyvmmbnaolcrg.supabase.co
# PORTAL_WEBHOOK_SECRET=
# Invite emails go out when contact_email is set. Set true to suppress them.
# PORTAL_SKIP_INVITE=false

# ─── Server ───────────────────────────────────────────────────────────
# PORT and RAILWAY_PUBLIC_DOMAIN are set automatically by Railway.
# DATABASE_URL is injected by the Postgres plugin — do NOT set manually.
#
# On boot: apply-schema-to-db.js (empty DB only), then run-migrations.js (002–010, schema_migrations). Skip with:
# SKIP_DB_MIGRATIONS=1
#
# Optional: if set (e.g. 1), boot and GET /health fail until that many active clients exist. Use after first client is created.
# MIN_ACTIVE_CLIENTS=1

# ─── SmartLead ────────────────────────────────────────────────────────
# Convert plain-text Slack replies to minimal HTML for SmartLead (links + line breaks). Set to 0 to send plain text only.
# SMARTLEAD_OUTBOUND_HTML=1
#
# Inbound webhook: skip non-reply events, parse HTML/plain from payload, reconcile duplicate REPLY rows via message-history. Set to 0 for legacy behavior.
# SMARTLEAD_WEBHOOK_ENHANCEMENTS=1

# ─── HeyReach polling backstop ───────────────────────────────────────
# Webhooks are primary. This polling backstop scans recent conversations to recover delayed/missed HeyReach replies.
# SMARTLEAD_POLL_ENABLED=1
# SMARTLEAD_POLL_MINUTES=5
# SMARTLEAD_POLL_LOOKBACK_HOURS=48
# SMARTLEAD_POLL_MAX_REPLIES=40
# DISABLE_SMARTLEAD_POLLING=0

# HEYREACH_POLL_ENABLED=1
# HEYREACH_POLL_MINUTES=3
# HEYREACH_POLL_LOOKBACK_HOURS=8
# HEYREACH_POLL_MAX_CONVERSATIONS=100
# Optional: comma-separated LinkedIn account IDs to limit the poller.
# HEYREACH_POLL_ACCOUNT_IDS=12345,67890
#
# Normally client-level API keys/slack routing live in the clients table.
# Temporary fallback if DB clients are not restored yet:
# HEYREACH_POLL_CLIENTS_JSON=[{"id":"salesglider","name":"SalesGlider","heyreach_api_key":"...","slack_bot_token":"xoxb-...","slack_channel_id":"C...","booking_link":"https://...","voice_prompt":"..."}]

# ─── Digest cadence ──────────────────────────────────────────────────
# Morning (8am client TZ) and afternoon (3pm Central) attention digests are OFF by default.
# Set ATTENTION_DIGESTS_ENABLED=1 to re-enable.
# ATTENTION_DIGESTS_ENABLED=0
# AFTERNOON_DIGEST_TIMEZONE=America/Chicago
# AFTERNOON_DIGEST_HOUR=15
SERPER_API_KEY=

# Follow-up card sequence for positive replies (off by default; every step is a Slack card a human clicks)
# FOLLOWUP_SEQUENCE_ENABLED=false
# Callers: Slack user id -> display name. JSON or comma list. Scripts say "(name)" literally so whoever
# calls says their own name. Cards @-mention every caller until one of them clicks an outcome; that
# caller then owns the lead (later cards @-mention only them).
# FOLLOWUP_CALLERS=U0CAL8ZDG92:Gabe,U0BL8JT75KN:Cayden
# (legacy single caller, used only when FOLLOWUP_CALLERS is unset)
# FOLLOWUP_CALLER_NAME=Gabe
# FOLLOWUP_CALLER_SLACK_ID=
# FOLLOWUP_SEQUENCE_START=             # optional ISO time; only replies at/after it enrol
# FOLLOWUP_SEQUENCE_MAX_AGE_HOURS=6    # never enrol a reply older than this
# FOLLOWUP_CALL_START_HOUR=9           # lead local call window
# FOLLOWUP_CALL_END_HOUR=17
# FOLLOWUP_VM_EMAIL_DELAY_MINUTES=5    # after "No answer / VM" on the Day 0 call
# FOLLOWUP_PHONE_WAIT_MINUTES=10       # how long the Day 0 call waits for phone enrichment

# Ghosted-meeting follow-up (off by default). Finds booked meetings the prospect never showed up to
# and posts one rebook email card (Approve & Send / Edit / Reject=skip) tagging Gabe and Cayden.
# Obvious no-show = no Fireflies recording, OR recording under 5 minutes, OR only one person on the call.
# Cards only: nothing is sent to a lead without a click. Needs FIREFLIES_API_KEY to decide;
# without it meetings are HELD (ghosted_meeting_checks, reason fireflies_not_configured).
# GHOSTED_MEETING_ENABLED=false
# GHOSTED_MEETING_DRY_RUN=false         # decide + log but enroll nothing
# GHOSTED_MEETING_START=                # optional ISO time; meetings that ended before it are ignored
# GHOSTED_MEETING_GRACE_MINUTES=5       # wait this long after the meeting end before deciding (scan runs every 2 min)
# GHOSTED_MEETING_MIN_MINUTES=5         # a recording shorter than this is a no-show
# GHOSTED_MEETING_MENTIONS=U0CAL8ZDG92:Gabe,U0BL8JT75KN:Cayden   # who the rebook card tags
# GHOSTED_MEETING_FULL_SEQUENCE=false   # true also adds the missed-meeting call cards, day 2 email and breakup
# GHOSTED_MEETING_LOOKBACK_HOURS=48     # never act on a meeting that ended longer ago than this
# GHOSTED_MEETING_DEFAULT_MINUTES=30    # length assumed when the booking has no end time

# Client positive-reply roll-up (Josh, Oct 29 2026). rollup (default) | instant | off.
PROSPECT_REPLY_NOTIFY_MODE=rollup
# CLIENT_DIGEST_ENABLED=false   # turns the 4:00pm CT weekday cron off
# CLIENT_DIGEST_CRON=0 16 * * 1-5
# Meeting-booked brief: set BOOKED_BRIEF_DATA=off to skip the Smartlead/web/model lookups.
# Day-of client brief review notice (email or webhook). Default mailbox is in docs/.env.example.
# REVIEW_NOTIFY=salesglider-briefs@mail.grokbot.com
# CLIENT_DAYOF_BRIEF_ENABLED=false
# Internal writer + cron hold. Leave off so EA is the only writer.
# CLIENT_DAYOF_BRIEF_WRITER_ENABLED=false
# CLIENT_DAYOF_BRIEF_LEAD_MINUTES=120

# Our own addresses are never a client contact, a reply-all CC, a referral or a heads-up recipient.
# Built in: joshua@ / cayden@salesglidergrowth.com, salesglidergrowth.com / gosalesglider.com / salesglider.com,
# PRIMARY_GMAIL_FROM, FYI_*, BOOKED_MEETING_EMAIL_*. Add Josh's personal Gmail etc. here (comma separated).
# OWN_ADDRESSES=
# OWN_DOMAINS=
