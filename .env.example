# ─── AI Classification ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Manual-reply retrieval + Claude drafting ────────────────────────
# Supabase stores only genuine manual SmartLead replies:
# direction='outbound' AND sequence_number IS NULL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Current model defaults (optional overrides):
# ANTHROPIC_REPLY_MODEL=claude-sonnet-5
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Slack ────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Required in production. Protects /dashboard, client CRUD, OAuth admin
# routes, and /admin/test/* diagnostics. First browser visit:
#   /dashboard?secret=<this value>
WEBHOOK_TEST_SECRET=long-random-string-for-local-slack-testing

# Optional: IANA timezone for displaying verified slot labels (default America/New_York)
# DEFAULT_BOOKING_TIMEZONE=America/Los_Angeles

# Post a follow-up approval card after an unanswered approved send.
FOLLOW_UP_HOURS=3
FOLLOW_UP_MAX_AGE_HOURS=24
# FOLLOW_UP_CHECK_MINUTES=5
# DISABLE_FOLLOW_UP_RUNNER=0

# ─── Lead Enrichment ─────────────────────────────────────────────────
# Waterfall for client notify: GetLeads → AI Ark → LeadMagic
GETLEADS_API_KEY=your-getleads-api-key
AIARK_API_KEY=your-ai-ark-api-key
LEADMAGIC_API_KEY=your-leadmagic-api-key
# Per-provider lookup deadline; approve/send waits only for an in-flight claim.
ENRICH_PROVIDER_TIMEOUT_MS=8000
ENRICH_SEND_WAIT_MS=12000

# ─── Primary Gmail (client notify from joshua@salesglidergrowth.com) ─
GMAIL_CLIENT_ID=your-gmail-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
PRIMARY_GMAIL_FROM=joshua@salesglidergrowth.com
# Cube ACR recordings are found recursively under this Drive folder.
CUBE_ACR_DRIVE_FOLDER_ID=your-google-drive-folder-id

# ─── Google Calendar OAuth (console.cloud.google.com) ────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Microsoft / Outlook OAuth (portal.azure.com) ────────────────────
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret

# ─── Server ───────────────────────────────────────────────────────────
# PORT and RAILWAY_PUBLIC_DOMAIN are set automatically by Railway.
# DATABASE_URL is injected by the Postgres plugin — do NOT set manually.
#
# On boot: apply-schema-to-db.js (empty DB only), then run-migrations.js (002–020, schema_migrations). Skip with:
# SKIP_DB_MIGRATIONS=1
#
# Optional: if set (e.g. 1), boot and GET /health fail until that many active clients exist. Use after first client is created.
# MIN_ACTIVE_CLIENTS=1

# ─── SmartLead ────────────────────────────────────────────────────────
# Convert plain-text Slack replies to minimal HTML for SmartLead (links + line breaks). Set to 0 to send plain text only.
# SMARTLEAD_OUTBOUND_HTML=1
#
# Inbound webhook: skip non-reply events, parse HTML/plain from payload, reconcile duplicate REPLY rows via message-history. Set to 0 for legacy behavior.
# SMARTLEAD_WEBHOOK_ENHANCEMENTS=1
# Account-wide key: targeted sends, interested sweep, and one-pass recovery
# routed strictly through smartlead_campaign_routes.
SMARTLEAD_MASTER_API_KEY=your-account-level-smartlead-key
# SMARTLEAD_MASTER_POLL_ENABLED=1
# SMARTLEAD_MASTER_POLL_MAX_REPLIES=80
# SWEEP_INTERESTED_ENABLED=1
# SWEEP_INTERESTED_MINUTES=30
# SWEEP_INTERESTED_ON_BOOT=1

# ─── HeyReach polling backstop ───────────────────────────────────────
# Webhooks are primary. This polling backstop scans recent conversations to recover delayed/missed HeyReach replies.
# SMARTLEAD_POLL_ENABLED=1
# SMARTLEAD_POLL_MINUTES=5
# SMARTLEAD_POLL_LOOKBACK_HOURS=168
# SMARTLEAD_POLL_MAX_REPLIES=40
# DISABLE_SMARTLEAD_POLLING=0

# HEYREACH_POLL_ENABLED=1
# HEYREACH_POLL_MINUTES=3
# HEYREACH_POLL_LOOKBACK_HOURS=168
# HEYREACH_POLL_MAX_CONVERSATIONS=100
# Optional: comma-separated LinkedIn account IDs to limit the poller.
# HEYREACH_POLL_ACCOUNT_IDS=12345,67890
#
# Normally client-level API keys/slack routing live in the clients table.
# Temporary fallback if DB clients are not restored yet:
# HEYREACH_POLL_CLIENTS_JSON=[{"id":"salesglider","name":"SalesGlider","heyreach_api_key":"...","slack_bot_token":"xoxb-...","slack_channel_id":"C...","booking_link":"https://...","voice_prompt":"..."}]

# ─── Digest cadence ──────────────────────────────────────────────────
# Morning (8am client TZ) and afternoon (3pm Central) attention digests are OFF by default.
# Set ATTENTION_DIGESTS_ENABLED=1 to re-enable.
# ATTENTION_DIGESTS_ENABLED=0
# AFTERNOON_DIGEST_TIMEZONE=America/Chicago
# AFTERNOON_DIGEST_HOUR=15

# ─── Call booking detection ──────────────────────────────────────────
# Allo auth is the raw key (no Bearer prefix). Phone numbers are discovered
# from /numbers unless ALLO_PHONE_NUMBERS pins a subset.
ALLO_API_KEY=your-allo-api-key
# ALLO_BASE_URL=https://api.withallo.com
# ALLO_PHONE_NUMBERS=+12149107558,+18633049904
