# Day-of client meeting briefs are held for review. The reviewer notice goes
# here: a webhook URL, or an email. An email subject starts with
# "[Client brief review]", then the lead, company, and meeting time.
# The body is the rendered brief plus release, enrich, and block links.
REVIEW_NOTIFY=salesglider-briefs@mail.grokbot.com
# CLIENT_DAYOF_BRIEF_ENABLED=false
# Internal writer + cron hold. Leave off so EA is the only writer.
# CLIENT_DAYOF_BRIEF_WRITER_ENABLED=false
# CLIENT_DAYOF_BRIEF_LEAD_MINUTES=120
